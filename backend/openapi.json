{
  "openapi": "3.1.0",
  "info": {
    "title": "МТС — дашборд координатора инцидентов",
    "description": "API дашборда координатора. PostgreSQL хранит пользователей и инциденты; SSE передаёт обновления подключённым клиентам.\n\nНачальный список: `GET /api/incidents`. Обновления: `GET /api/incidents/stream` через EventSource. SSE — бесконечный ответ, поэтому его удобнее проверять через EventSource или curl -N.\n\nФормат исходной выгрузки сохранён; группы и SLA вычисляются по её атрибутам. Группы внимания доступны только для чтения. Автоматическое слежение за JSON, авторизация и Telegram-бот пока не реализованы.",
    "version": "0.2.0"
  },
  "paths": {
    "/api/incidents/stream": {
      "get": {
        "tags": [
          "incidents"
        ],
        "summary": "Subscribe to live incident updates",
        "description": "Live-only, currently unauthenticated feed. The producer broadcasts JSON incident arrays without an event name for the existing frontend onmessage handler. No initial snapshot or Last-Event-ID replay is implemented yet.",
        "operationId": "stream_incidents_api_incidents_stream_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/incidents": {
      "get": {
        "tags": [
          "incidents"
        ],
        "summary": "Получить список инцидентов",
        "description": "Начальный снимок из PostgreSQL. Для последующих обновлений используется SSE-подписка.",
        "operationId": "list_incidents_api_incidents_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/IncidentResponse"
                  },
                  "type": "array",
                  "title": "Response List Incidents Api Incidents Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/incidents/{incident_id}": {
      "get": {
        "tags": [
          "incidents"
        ],
        "summary": "Получить инцидент по ID",
        "operationId": "get_incident_api_incidents__incident_id__get",
