{
  "openapi": "3.1.0",
  "info": {
    "title": "МТС Incident Command API",
    "version": "0.2.0"
  },
  "paths": {
    "/api/incidents/stream": {
      "get": {
        "tags": [
          "incidents"
        ],
        "summary": "Subscribe to live incident updates",
        "description": "Authenticated live-only feed of incident arrays. No initial snapshot or Last-Event-ID replay. The stream closes on logout or session expiry.",
        "operationId": "stream_incidents_api_incidents_stream_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          }
        ]
      }
    },
    "/api/incidents": {
      "get": {
        "tags": [
          "incidents"
        ],
        "summary": "Получить список инцидентов",
        "description": "Начальный снимок из PostgreSQL. Для последующих обновлений используется SSE-подписка.",
        "operationId": "list_incidents_api_incidents_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/IncidentResponse"
                  },
                  "type": "array",
                  "title": "Response List Incidents Api Incidents Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          }
        ]
      },
      "post": {
        "tags": [
          "incidents"
        ],
        "summary": "Создать или обновить инцидент",
        "description": "Принимает один инцидент в формате ITSM-экспорта. Операция идемпотентна: повторная отправка того же `id` обновит запись (upsert). После сохранения обновлённый объект рассылается всем SSE-подписчикам.",
        "operationId": "create_incident_api_incidents_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IncidentCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentCreateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Ошибка валидации — неверный формат поля"
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          }
        ]
      }
    },
    "/api/incidents/{incident_id}/resolve": {
      "post": {
        "tags": [
          "incidents"
        ],
        "summary": "Отметить инцидент как решённый",
        "description": "Переводит инцидент в статус Resolved, фиксирует дату завершения и уведомляет подписчиков через SSE.",
        "operationId": "resolve_incident_api_incidents__incident_id__resolve_post",
        "security": [
          {
            "APIKeyCookie": []
          }
        ],
        "parameters": [
          {
            "name": "incident_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Incident Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentResponse"
                }
              }
            }
          },
          "404": {
            "description": "Инцидент не найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/incidents/{incident_id}/assign": {
      "post": {
        "tags": [
          "incidents"
        ],
        "summary": "Назначить команду на инцидент",
        "description": "Обновляет назначенную команду (assignedGroupName), фиксирует дату назначения и рассылает SSE.",
        "operationId": "assign_incident_api_incidents__incident_id__assign_post",
        "security": [
          {
            "APIKeyCookie": []
          }
        ],
        "parameters": [
          {
            "name": "incident_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Incident Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IncidentAssignRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentResponse"
                }
              }
            }
          },
          "404": {
            "description": "Инцидент не найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/incidents/{incident_id}": {
      "get": {
        "tags": [
          "incidents"
        ],
        "summary": "Получить инцидент по ID",
