{$SITE_DOMAIN} {
    @backend path /api/* /health /docs /docs/* /openapi.json /redoc /swagger
    handle @backend {
        reverse_proxy backend:8000 {
            flush_interval -1
        }
    }

    handle {
        root * /srv
        encode zstd gzip
        try_files {path} /index.html
        file_server
    }
}
