{$SITE_DOMAIN} {
    @backend path /api /api/* /health /docs /docs/* /openapi.json /redoc /swagger
    handle @backend {
        reverse_proxy backend:8000 {
            flush_interval -1
        }
    }

    @pwa path /sw.js /workbox-*.js /manifest.webmanifest
    handle @pwa {
        root * /srv
        encode zstd gzip
        header Cache-Control "no-cache, must-revalidate"
        file_server
    }

    handle /assets/* {
        root * /srv
        encode zstd gzip
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle {
        root * /srv
        encode zstd gzip
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}
